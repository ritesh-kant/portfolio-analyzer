{
  "name": "portfolio-analyzer",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky",
    "bt:setup": "cd apps/signal-engine && uv sync --all-extras",
    "bt": "apps/signal-engine/.venv/bin/python research/backtests/bt17_momentum_pool.py",
    "bt:report": "apps/signal-engine/.venv/bin/python research/backtests/bt32_strategy_report.py",
    "bt:demo": "apps/signal-engine/.venv/bin/python research/backtests/bt17_momentum_pool.py --attention --multi-entry --start 2024-01-01 --end 2024-12-31 --symbols BALRAMCHIN,CUB,ABFRL,DELHIVERY,DEVYANI,CHAMBLFERT,COROMANDEL,CANFINHOME,BATAINDIA,BRIGADE,CYIENT,ATGL,AFFLE,ASTERDM,CLEAN --tag demo15 && apps/signal-engine/.venv/bin/python research/backtests/bt32_strategy_report.py --trades research/backtests/bt17_trades_demo15.csv",
    "bt:serve": "python3 -m http.server 8899 --directory research/backtests"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.4.2",
    "serverless": "^4.5.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
