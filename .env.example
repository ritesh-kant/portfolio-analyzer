# ── Serverless Framework ─────────────────────────────────────────────────────
# Get from: app.serverless.com → account → Access Keys (required for pnpm dev)
SERVERLESS_ACCESS_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Comma-separated list of Google email addresses allowed to sign in
ALLOWED_EMAILS=your.email@gmail.com
# Allowed frontend origin (used for CORS in Lambda services)
ALLOWED_ORIGIN=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://admin:admin123@localhost:27018/portfolio_analyzer?authSource=admin

# ── Zerodha Kite Connect ─────────────────────────────────────────────────────
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# ── AI Provider ──────────────────────────────────────────────────────────────
# anthropic | openai | gemini | kimi | deepseek | ollama
AI_PROVIDER=ollama

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Kimi via NVIDIA API (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
KIMI_MODEL=moonshotai/kimi-k2-instruct

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama (local — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=600000

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SIGNALS_API_BASE=http://localhost:5001
NEXT_PUBLIC_TRADING_API_BASE=http://localhost:6002

# ── Signal Engine ─────────────────────────────────────────────────────────────
SIGNAL_ENGINE_API_KEY=local-dev-key-change-in-prod

# LLM safety limits
LLM_TIMEOUT_S=30
LLM_DAILY_SPEND_LIMIT_USD=5.0

# Trading mode: paper (no real orders) | live (Zerodha)
TRADING_MODE=paper

# ── Observability (optional) ─────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=trading-signals
ALERT_WEBHOOK_URL=

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
# SSM prefix used by secrets.py on Lambda (must match serverless.yml)
STAGE=dev
# Set to "true" on Lambda to activate SSM secret resolution at cold-start
AWS_SECRETS_ENABLED=false

# ── News Trader ───────────────────────────────────────────────────────────────
NT_NEWS_DELAY_SECONDS=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to "true" to run outside 09:00–15:35 IST during local dev/testing
NT_BYPASS_MARKET_HOURS=false
# Set to "true" to run on NSE holidays during local dev/testing
NT_BYPASS_MARKET_HOLIDAY=false

# ── Momentum-trader (Upstox) ─────────────────────────────────────────────────
# Analytics token is read-only, valid for one year, and is preferred for paper scanning.
# Create it under Upstox Developer Apps > Analytics. Never commit the real value.
UPSTOX_ANALYTICS_TOKEN=
# Legacy OAuth credentials. The access token expires 03:30 IST daily; leave blank when
# UPSTOX_ANALYTICS_TOKEN is configured.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765/callback
UPSTOX_ACCESS_TOKEN=
MT_RISK_INR=500
MT_MAX_NOTIONAL_INR=50000
MT_MAX_POSITIONS=5
MT_STRATEGY=baseline
# Two-list paper strategy: +1.5% / 1.5x promotes attention; a later confirmed
# 1-minute candle arms a future-only buy-stop.
# MT_STRATEGY=attention_1m
# MT_ATTENTION_DAY_CHG_MIN=1.5
# MT_ATTENTION_RVOL_MIN=1.5
# MT_LOG_CSV=research/backtests/mt_attention_1m_forward_log.csv
# Use a separate file for the registered catalyst-first-pullback paper test.
# MT_STRATEGY=catalyst_first_pullback
# MT_LOG_CSV=research/backtests/mt_catalyst_first_pullback_forward_log.csv
