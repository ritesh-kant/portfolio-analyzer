# ── Auth (required) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Comma-separated list of Google email addresses allowed to sign in
ALLOWED_EMAILS=your.email@gmail.com

# Allowed frontend origin (used for CORS in Lambda services)
ALLOWED_ORIGIN=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://admin:admin123@localhost:27018/portfolio_analyzer?authSource=admin

# Zerodha Kite Connect
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Benchmark API
MFAPI_SCHEME_CODE=120716

# ── Signals Service ─────────────────────────────────────────────────────────

# Data APIs
NEWSDATA_API_KEY=your_newsdata_api_key_here

# AI Provider selection: anthropic | openai | gemini | kimi | ollama
AI_PROVIDER=ollama

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash

# Kimi 2.5 via NVIDIA API (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
KIMI_MODEL=moonshotai/kimi-k2-instruct

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama (local — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_MODEL=llama3.2:latest 
OLLAMA_TIMEOUT=600000

# Frontend (Next.js)
NEXT_PUBLIC_SIGNALS_API_BASE=http://localhost:5001
NEXT_PUBLIC_TRADING_API_BASE=http://localhost:6002

# ── Trading Service ──────────────────────────────────────────────────────────

# Signal Engine (Python FastAPI)
SIGNAL_ENGINE_URL=http://localhost:8000
SIGNAL_ENGINE_API_KEY=local-dev-key-change-in-prod

# LLM safety limits
LLM_TIMEOUT_S=30
LLM_DAILY_SPEND_LIMIT_USD=5.0

# Trading mode: paper (no real orders) | live (Zerodha)
TRADING_MODE=paper
VIRTUAL_PORTFOLIO_INITIAL=100000
MIN_SIGNAL_CONFIDENCE=60
MAX_POSITIONS=8
POSITION_SIZE_PCT=12

# Scheduler (cron expressions in UTC)
PIPELINE_CRON=30 0 * * 1-5
MONITOR_CRON=15,45 3-9 * * 1-5

# Queue
QUEUE_PROVIDER=local

# Zerodha live trading (paper mode — leave blank)
ZERODHA_MCP_URL=https://mcp.kite.trade

# Observability (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=trading-signals
ALERT_WEBHOOK_URL=

# AWS (leave empty for local development)
AWS_REGION=ap-south-1
SQS_QUEUE_URL=
# Set to "sqs" to route pipeline-run dispatch through SQS (requires AWS creds)
QUEUE_PROVIDER=local
# Container image tag deployed to ECR (used by Terraform + CI/CD)
SIGNAL_ENGINE_IMAGE_TAG=latest
# SSM prefix used by secrets.py on Lambda (must match serverless.yml + Terraform)
STAGE=dev
# Set to "true" on Lambda to activate SSM secret resolution at cold-start
AWS_SECRETS_ENABLED=false
