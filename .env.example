# MongoDB
MONGODB_URI=mongodb://admin:admin123@localhost:27017/portfolio_analyzer?authSource=admin

# Zerodha Kite Connect
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Benchmark API
MFAPI_SCHEME_CODE=120716

# ── Signals Service ─────────────────────────────────────────────────────────

# Data APIs
NEWSDATA_API_KEY=your_key_here

# AI Provider selection: anthropic | openai | gemini | kimi | ollama
AI_PROVIDER=kimi

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash

# Kimi 2.5 via NVIDIA API (https://build.nvidia.com)
NVIDIA_API_KEY=your_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
KIMI_MODEL=moonshotai/kimi-k2-instruct

# Ollama (local — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Frontend (Next.js)
NEXT_PUBLIC_SIGNALS_API_BASE=http://localhost:5001
