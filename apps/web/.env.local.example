# Generate with: openssl rand -base64 32
AUTH_SECRET=

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of emails allowed to sign in
ALLOWED_EMAILS=your.email@gmail.com

# Required by NextAuth v5
NEXTAUTH_URL=http://localhost:3000

# Backend service URLs (defaults work for local dev)
NEXT_PUBLIC_PORTFOLIO_API_BASE=http://localhost:3001
NEXT_PUBLIC_ANALYTICS_API_BASE=http://localhost:4001
NEXT_PUBLIC_SIGNALS_API_BASE=http://localhost:5001
NEXT_PUBLIC_TRADING_API_BASE=http://localhost:6002
